{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plav",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-21",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "vars": {
    "PLAV_OWNER_ID": "eff743b5-3bcc-435b-b335-c3cc266d673e",
    "SUPABASE_URL": "https://duxsquqvqaigcxtmsxvv.supabase.co"
  },

  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "yt-player-audio"
    }
  ]
}
